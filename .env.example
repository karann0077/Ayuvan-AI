# Application
APP_NAME=AYUVAN Backend
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# Database. Use a dedicated, least-privileged database role in production.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/ayuvan

# Redis / background worker
REDIS_URL=redis://localhost:6379/0
USE_ARQ=false

# Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=replace-with-a-long-random-token
GRAPH_API_VERSION=v22.0
WHATSAPP_TEST_RECIPIENT=
# Optional: set only after a matching Flow is created and published in Meta.
# Its accepted response fields are validated server-side.
WHATSAPP_SYMPTOM_INTAKE_FLOW_ID=
WHATSAPP_SYMPTOM_INTAKE_FLOW_SCREEN=SYMPTOM_INTAKE

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used automatically when the preferred model is rate-limited or unavailable.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Security / development behaviour
# Never enable auto-provisioning for a public deployment.
ALLOW_TEST_USER_AUTO_PROVISION=false
TEST_USER_PHONE=
